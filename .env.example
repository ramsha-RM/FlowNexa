NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false

MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

COOKIE_SAMESITE=lax
COOKIE_SECURE=false

REQUIRE_EMAIL_VERIFICATION=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google-callback

MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# In production, set this to a persistent shared volume mounted by every server instance.
RESUME_STORAGE_DIR=
